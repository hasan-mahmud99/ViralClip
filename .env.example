# =====================================================================
# ViralClip environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# =====================================================================

NODE_ENV=production
# DRY_RUN=true means: discovery/processing/rendering allowed, publishing is NEVER performed
# (logs "WOULD_PUBLISH" instead). Set to false only after testing with the mock/real publisher.
DRY_RUN=true

# --- Server ---
API_PORT=4000
API_HOST=0.0.0.0
DASHBOARD_PORT=5173
ADMIN_PASSWORD=change-me

# --- Databases ---
DATABASE_URL=postgresql://viralclip:viralclip@postgres:5432/viralclip?schema=public
REDIS_URL=redis://redis:6379

# --- API keys (leave empty in mock mode) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

YOUTUBE_API_KEY=
YOUTUBE_SEARCH_QUERIES=viral creator moments,unexpected reactions,best challenge moments
YOUTUBE_MAX_RESULTS=10
YOUTUBE_LOOKBACK_HOURS=168
YOUTUBE_LANGUAGE=en
YOUTUBE_REGION=US
ENABLE_DYNAMIC_QUERIES=false

META_ACCESS_TOKEN=
META_PAGE_ID=
META_API_VERSION=v22.0

# --- AI provider ---
LLM_PROVIDER=gemini
GEMINI_MAX_RETRIES=4
GEMINI_RETRY_BASE_MS=1000
GEMINI_CONCURRENCY=2

# --- Content & rights ---
TIMEZONE=Asia/Dhaka
DAILY_REEL_TARGET=3
PUBLISH_TIMES=09:00,14:00,20:00
APPROVAL_MODE=manual
# manual | approved_only | licensed_only | trusted_sources
SOURCE_RIGHTS_POLICY=approved_only
COMMENTARY_LANGUAGE=bn

AUTHORIZED_YOUTUBE_CHANNELS=
TRUSTED_CHANNELS=

# --- Content limits ---
MIN_MOMENT_SCORE=7.5
MIN_REEL_SCORE=7.5
MIN_CLIP_SECONDS=10
MAX_CLIP_SECONDS=60
MIN_REEL_SECONDS=20
MAX_REEL_SECONDS=60

# --- Features ---
SUBTITLES_ENABLED=true
MUSIC_ENABLED=false
MUSIC_DIRECTORY=media/music

# --- TTS ---
TTS_PROVIDER=mock

# --- Storage (local MVP; keep StorageProvider abstract for S3 later) ---
STORAGE_BASE_PATH=media
SOURCE_STORAGE=media/sources
AUDIO_STORAGE=media/audio
SUBTITLE_STORAGE=media/subtitles
RENDER_STORAGE=media/renders
THUMBNAIL_STORAGE=media/thumbnails

# --- Concurrency (small EC2 friendly) ---
TRANSCRIPTION_CONCURRENCY=1
RENDER_CONCURRENCY=1
GEMINI_CONCURRENCY=2
PUBLISH_CONCURRENCY=1

# --- Rendering ---
RENDER_WIDTH=1080
RENDER_HEIGHT=1920

# --- Scheduling / orchestration ---
PREPARE_TIME=02:00
SCHEDULER_ENABLED=true

# --- faster-whisper (native, hybrid local setup) ---
TRANSCRIPTION_PROVIDER=mock
WHISPER_PYTHON=python
WHISPER_SCRIPT=infra/python/transcribe.py
WHISPER_MODEL=small
